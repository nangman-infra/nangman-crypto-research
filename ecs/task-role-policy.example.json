{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadCandidateBundles",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::nangman-crypto-dev-intel-candidate-<account-suffix>/candidate-evidence-bundle/priority=p0/*",
        "arn:aws:s3:::nangman-crypto-dev-intel-candidate-<account-suffix>/candidate-evidence-bundle/priority=p1/*",
        "arn:aws:s3:::nangman-crypto-dev-intel-candidate-<account-suffix>/candidate-evidence-bundle/priority=p2/*"
      ]
    },
    {
      "Sid": "ReadMarketL1ReplayInputs",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::nangman-crypto-dev-market-ingest-l1-<account-suffix>",
        "arn:aws:s3:::nangman-crypto-dev-market-ingest-l1-<account-suffix>/*"
      ]
    },
    {
      "Sid": "ListResearchRuntimeState",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::nangman-crypto-dev-research-<account-suffix>"
      ]
    },
    {
      "Sid": "ReadHistoricalResearchOutputs",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::nangman-crypto-dev-research-<account-suffix>/research-input-manifest/*",
        "arn:aws:s3:::nangman-crypto-dev-research-<account-suffix>/retest-cycle-source-state/*",
        "arn:aws:s3:::nangman-crypto-dev-research-<account-suffix>/replay-run/*",
        "arn:aws:s3:::nangman-crypto-dev-research-<account-suffix>/replay-run-index/*",
        "arn:aws:s3:::nangman-crypto-dev-research-<account-suffix>/hypothesis-harness/hypothesis-harness-result/*"
      ]
    },
    {
      "Sid": "WriteResearchReports",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::nangman-crypto-dev-research-<account-suffix>/research-run-report/*",
        "arn:aws:s3:::nangman-crypto-dev-research-<account-suffix>/replay-run/*",
        "arn:aws:s3:::nangman-crypto-dev-research-<account-suffix>/replay-run-index/*",
        "arn:aws:s3:::nangman-crypto-dev-research-<account-suffix>/shadow-validation-run/*",
        "arn:aws:s3:::nangman-crypto-dev-research-<account-suffix>/retest-cycle-source-state/*",
        "arn:aws:s3:::nangman-crypto-dev-research-<account-suffix>/research-aggregate-registry/*"
      ]
    }
  ]
}
